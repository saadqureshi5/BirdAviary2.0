{
  "productName": "Bird Aviary",
  "version": "2.0.0",
  "identifier": "com.birdaviary.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bird Aviary 2.0",
        "width": 1280,
        "height": 800,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/api"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    }
  }
}
